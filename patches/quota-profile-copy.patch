--- /dev/null
+++ b/agent/quota_profile_copy.py
@@ -0,0 +1,15 @@
+"""Optional profile copy for structured quota failures; no routing or retry changes."""
+from agent.i18n import t
+
+
+def apply_profile_quota_copy(result):
+    reason = result.get("failure_reason")
+    if (result.get("failed") is not True or result.get("partial")
+            or result.get("usage_window_message") or reason not in ("billing", "rate_limit")):
+        return result
+    key = "profile.quota." + reason
+    text = t(key)
+    # Opt in only when a profile/language pack actually supplies this text.
+    if text == key or not text.strip():
+        return result
+    return {**result, "final_response": text}
