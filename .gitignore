.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
auth.json
gateway.json
secrets/
.oci/
.hermes/
.venv/
__pycache__/
*.py[cod]
*.log
*.sqlite*
*.db
backups/
runtime/
.terraform/
*.tfstate*
*.tfvars

# Local Codex task orchestration/scratch files are not project source.
l*-work/

# Recovery payloads/private operator records never belong in this public repo.
*.zip
*.age
*.bundle
*recovery-identity*
recovery-record*.json
!config/recovery-record.example.json

# Private automation runtime settings/state are never public fixtures.
hermes-backup-schedule.json
hermes-backup-notify.env
job.json
notify.json
