[Unit]
Description=Encrypted Hermes off-instance backup (instance principal)
Wants=network-online.target
After=network-online.target
OnFailure=hermes-backup-watch.service
OnSuccess=hermes-backup-watch.service

[Service]
Type=oneshot
User=hermes-agent
Group=hermes-agent
UMask=0077
ExecStart=/usr/bin/python3 /opt/hermes-agent-stack/scripts/scheduled_backup.py run --policy /etc/hermes-backup-schedule.json
StateDirectory=hermes-backup-automation
StateDirectoryMode=0700
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes-agent /var/lib/hermes-backup-automation
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindDeny=any
Restart=no
