[Unit]
Description=Hermes UA personal text Telegram gateway
Wants=network-online.target
After=network-online.target docker.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=hermes-agent
Group=hermes-agent
SupplementaryGroups=docker
WorkingDirectory=/var/lib/hermes-agent/workspace
Environment=HERMES_HOME=/var/lib/hermes-agent
Environment=HERMES_RUNTIME_DIR=/var/lib/hermes-agent/tools
Environment=GATEWAY_ALLOW_ALL_USERS=false
EnvironmentFile=/var/lib/hermes-agent/.env
ExecStartPre=/usr/bin/python3 /opt/hermes-agent-stack/deploy/gateway_guard.py --config /var/lib/hermes-agent/config.yaml --secret-file /var/lib/hermes-agent/.env
ExecStart=/usr/bin/python3 /opt/hermes-agent-stack/scripts/hermes_runtime.py --source /opt/hermes-agent --home /var/lib/hermes-agent --tools /var/lib/hermes-agent/tools cli -- gateway run
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes-agent

[Install]
WantedBy=multi-user.target
