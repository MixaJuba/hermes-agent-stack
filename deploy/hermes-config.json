{
  "timezone": "Europe/Kyiv",
  "tools": {
    "tool_search": {
      "enabled": "off"
    }
  },
  "model": {
    "provider": "workers-ai",
    "default": "@cf/zai-org/glm-4.7-flash",
    "streaming": true
  },
  "fallback_model": [],
  "auth": {
    "adopt_external_logins": false
  },
  "security": {
    "allow_lazy_installs": false
  },
  "display": {
    "language": "uk"
  },
  "agent": {
    "max_turns": 8,
    "api_max_retries": 1,
    "auto_recovery_cycles": 0,
    "run_budget_seconds": 180
  },
  "max_concurrent_sessions": 1,
  "platform_toolsets": {
    "cli": [
      "terminal",
      "file",
      "memory",
      "session_search",
      "web",
      "clarify"
    ],
    "telegram": [
      "terminal",
      "file",
      "memory",
      "session_search",
      "web",
      "clarify"
    ]
  },
  "terminal": {
    "backend": "docker",
    "cwd": "/workspace",
    "timeout": 30,
    "lifetime_seconds": 300,
    "docker_image": "hermes-ua-sandbox:local",
    "docker_network": false,
    "docker_mount_cwd_to_workspace": false,
    "docker_run_as_host_user": true,
    "docker_forward_env": [],
    "docker_env": {},
    "docker_volumes": [],
    "docker_extra_args": [
      "--pids-limit",
      "128"
    ],
    "container_cpu": 1,
    "container_memory": 512,
    "container_persistent": true,
    "docker_shm_size": "64m"
  },
  "web": {
    "backend": "exa",
    "search_backend": "exa",
    "extract_backend": "exa",
    "keyless_fallback": false,
    "keyless_rescue": false
  },
  "memory": {
    "memory_enabled": true,
    "user_profile_enabled": true
  },
  "stt": {
    "enabled": false
  },
  "approvals": {
    "mode": "smart",
    "cron_mode": "deny",
    "single_query_mode": "deny"
  },
  "auxiliary": {
    "transient_retries": 0,
    "free_only": true,
    "vision": {
      "provider": "workers-ai",
      "model": "@cf/zai-org/glm-4.7-flash",
      "fallback_chain": []
    },
    "compression": {
      "provider": "workers-ai",
      "model": "@cf/zai-org/glm-4.7-flash",
      "fallback_chain": []
    },
    "skills_hub": {
      "provider": "workers-ai",
      "model": "@cf/zai-org/glm-4.7-flash",
      "fallback_chain": []
    },
    "approval": {
      "provider": "workers-ai",
      "model": "@cf/zai-org/glm-4.7-flash",
      "fallback_chain": []
    },
    "review": {
      "provider": "workers-ai",
      "model": "@cf/zai-org/glm-4.7-flash",
      "fallback_chain": []
    },
    "mcp": {
      "provider": "workers-ai",
      "model": "@cf/zai-org/glm-4.7-flash",
      "fallback_chain": []
    },
    "title_generation": {
      "provider": "workers-ai",
      "model": "@cf/zai-org/glm-4.7-flash",
      "fallback_chain": [],
      "enabled": false,
      "model_upgrade_enabled": false,
      "prefer_fast_model": false
    },
    "memory_query_rewrite": {
      "provider": "workers-ai",
      "model": "@cf/zai-org/glm-4.7-flash",
      "fallback_chain": []
    },
    "tts_audio_tags": {
      "provider": "workers-ai",
      "model": "@cf/zai-org/glm-4.7-flash",
      "fallback_chain": []
    },
    "voice_chat": {
      "provider": "workers-ai",
      "model": "@cf/zai-org/glm-4.7-flash",
      "fallback_chain": []
    },
    "triage_specifier": {
      "provider": "workers-ai",
      "model": "@cf/zai-org/glm-4.7-flash",
      "fallback_chain": []
    },
    "kanban_decomposer": {
      "provider": "workers-ai",
      "model": "@cf/zai-org/glm-4.7-flash",
      "fallback_chain": []
    },
    "profile_describer": {
      "provider": "workers-ai",
      "model": "@cf/zai-org/glm-4.7-flash",
      "fallback_chain": []
    },
    "goal_judge": {
      "provider": "workers-ai",
      "model": "@cf/zai-org/glm-4.7-flash",
      "fallback_chain": []
    },
    "curator": {
      "provider": "workers-ai",
      "model": "@cf/zai-org/glm-4.7-flash",
      "fallback_chain": []
    },
    "monitor": {
      "provider": "workers-ai",
      "model": "@cf/zai-org/glm-4.7-flash",
      "fallback_chain": []
    },
    "background_review": {
      "provider": "workers-ai",
      "model": "@cf/zai-org/glm-4.7-flash",
      "fallback_chain": [],
      "enabled": false
    }
  },
  "platforms": {
    "telegram": {
      "enabled": true,
      "dm_policy": "allowlist",
      "group_policy": "disabled",
      "allowed_chats": [],
      "guest_mode": false
    }
  },
  "streaming": {
    "enabled": true
  },
  "fallback_providers": [],
  "curator": {
    "enabled": false,
    "consolidate": false
  },
  "plugins": {
    "enabled": [
      "cloudflare-workers-ai-provider",
      "bro-recent-web"
    ],
    "auto_apply": false,
    "auto_update_check_hours": 0
  }
}
